# Copy to .env and fill in. NEVER commit your real .env.
BINANCE_API_KEY=
BINANCE_API_SECRET=

ACCOUNT_SIZE=1000
RISK_PER_TRADE_PCT=0.5
DAILY_MAX_LOSS_PCT=1.0
MONTHLY_MAX_LOSS_PCT=1.0
MAX_OPEN_POSITIONS=5
MAX_PER_SYMBOL_PCT=25

# paper (safe) | live (real orders - be careful)
TRADING_MODE=paper
# auto | live | demo
DATA_MODE=auto

SCAN_LIMIT=40
TIMEFRAME=1h

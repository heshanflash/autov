# Secrets - NEVER commit API keys
.env
*.env
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Runtime state (paper account ledger, risk state, settings)
state/*.json
!state/.gitkeep

# Node
node_modules/
package-lock.json
*.tgz

# Android build intermediates (dist/*.apk is the deliverable and IS tracked)
android/build/
android/.tools/

# Logs & OS
*.log
.DS_Store
